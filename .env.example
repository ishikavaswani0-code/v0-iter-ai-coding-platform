# IterAI Environment Variables Template
# Copy this file to .env.local and fill in your API keys

# ============================================
# JUDGE0 API - Code Execution Service
# ============================================
# Get your API key from: https://judge0.com
# Required for: Code execution in practice challenges
# Free tier available with usage limits

# Public key for client-side requests
NEXT_PUBLIC_JUDGE0_API_KEY=your_judge0_api_key_here

# Server-side key (if using server API)
JUDGE0_API_KEY=your_judge0_api_key_here

# ============================================
# GROQ API - AI Chatbot
# ============================================
# Get your API key from: https://console.groq.com
# Required for: AI mentor chatbot functionality
# Free tier available with daily token limits

GROQ_API_KEY=your_groq_api_key_here

# ============================================
# Optional: Future Database Integration
# ============================================
# Uncomment these when you add a real database

# DATABASE_URL=your_database_connection_string
# DATABASE_USER=your_database_user
# DATABASE_PASSWORD=your_database_password

# ============================================
# Optional: Authentication Service
# ============================================
# Uncomment these when you upgrade from mock auth

# NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32
# NEXTAUTH_URL=http://localhost:3000
# SUPABASE_URL=your_supabase_project_url
# SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# Application Settings
# ============================================
# NODE_ENV=development
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Notes
# ============================================
# 1. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# 2. Don't commit .env.local to version control
# 3. Keep sensitive keys secure
# 4. Regenerate keys if they're ever exposed
# 5. Use different keys for development and production
